// --- MODUL 1: SYSTEM OPERATIONS (SYSOPS) ---
const SysOps = {
    execCmd(command, ignoreError = false) {
        try {
            return execSync(command, { encoding: 'utf-8', stdio: 'pipe' }).trim();
        } catch (error) {
            if (!ignoreError) throw new Error(error.stderr || error.message);
            return null;
        }
    },

    getProjects(baseDir) {
        if (!fs.existsSync(baseDir)) return [];
        return fs.readdirSync(baseDir, { withFileTypes: true })
            .filter(dirent => dirent.isDirectory())
            .map(dirent => dirent.name);
    },

    loadConfig() {
        if (!fs.existsSync(ENV_FILE)) return {};
        const content = fs.readFileSync(ENV_FILE, 'utf-8');
        const config = {};
        content.split('\n').forEach(line => {
            const [key, ...val] = line.split('=');
            if (key && val) config[key.trim()] = val.join('=').trim();
        });
        return config;
    },

    saveConfig(key, value) {
        const config = this.loadConfig();
        config[key] = value;
        const newContent = Object.entries(config).map(([k, v]) => `${k}=${v}`).join('\n');
        fs.writeFileSync(ENV_FILE, newContent, { mode: 0o600 });
    },

    hasPackageJson() {
        return fs.existsSync('package.json');
    }
};

// --- MODUL 2: GIT & GITHUB OPERATIONS (GITOPS) ---
const GitOps = {
    getStats() {
        const ahead = SysOps.execCmd('git rev-list --count HEAD@{u}..HEAD', true) || '0';
        const behind = SysOps.execCmd('git rev-list --count HEAD..HEAD@{u}', true) || '0';
        const status = SysOps.execCmd('git status --porcelain', true);
        const modified = status ? status.split('\n').length : 0;
        return { ahead, behind, modified };
    },

    initRepo(repoPath) {
        process.chdir(repoPath);
        if (!fs.existsSync(path.join(repoPath, '.git'))) {
            SysOps.execCmd('git init');
            SysOps.execCmd('git branch -M main');
            return true;
        }
        return false;
    },

    checkRemote(repoName) {
        const username = SysOps.execCmd('gh api user -q .login', true);
        if (!username) throw new Error('GitHub CLI session invalid.');
        const exists = SysOps.execCmd(`gh repo view ${username}/${repoName}`, true);
        return { username, exists: exists !== null };
    },

    createRemote(repoName, isPrivate) {
        const visibility = isPrivate ? '--private' : '--public';
        SysOps.execCmd(`gh repo create ${repoName} ${visibility} --source=. --remote=origin`);
    },

    getUnstagedFiles() {
        const statusLines = SysOps.execCmd('git status --porcelain');
        if (!statusLines) return [];
        return statusLines.split('\n').map(line => {
            const status = line.substring(0, 2);
            let file = line.substring(2).trim();
            
            if (file.includes(' -> ')) {
                file = file.split(' -> ')[1];
            }
            if (file.startsWith('"') && file.endsWith('"')) {
                file = file.slice(1, -1);
            }
            
            return { status, file };
        });
    },

    stageAllFiles() {
        SysOps.execCmd('git add .');
    },

    stageFiles(files) {
        files.forEach(file => SysOps.execCmd(`git add "${file}"`));
    },

    getStagedDiff() {
        return SysOps.execCmd('git diff --staged');
    },

    getCurrentBranch() {
        return SysOps.execCmd('git branch --show-current') || 'main';
    },

    getAllBranches() {
        const raw = SysOps.execCmd('git branch -v');
        if (!raw) return [];
        return raw.split('\n').map(b => ({
            name: b.replace('*', '').trim().split(/\s+/)[0],
            isCurrent: b.includes('*'),
            lastCommit: b.split(/\s+/).slice(2, 5).join(' ') || 'NO DATA'
        })).filter(b => b.name);
    },

    createAndCheckoutBranch(branchName) {
        SysOps.execCmd(`git checkout -b ${branchName}`);
    },

    switchBranch(branchName) {
        SysOps.execCmd(`git checkout ${branchName}`);
    },

    deleteBranches(branches) {
        branches.forEach(b => SysOps.execCmd(`git branch -D ${b}`));
    },

    commitAndPush(message, branch) {
        SysOps.execCmd(`git commit -m "${message}"`);
        SysOps.execCmd('git fetch origin', true);
        SysOps.execCmd(`git push -u origin ${branch}`);
    }
};

// --- MODUL 3: ARTIFICIAL INTELLIGENCE (AIOPS) ---
const AIOps = {
    async fetchAvailableModels(apiKey) {
        if (!apiKey) throw new Error('API key missing.');
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models?key=${apiKey}`);
        if (!response.ok) throw new Error('Failed to fetch model manifest from server.');
        
        const data = await response.json();
        return data.models
            .map(m => m.name.replace('models/', ''))
            .filter(name => 
                (name.includes('gemini') || name.includes('gemma')) && 
                !name.match(/image|tts|veo|imagen|embedding|aqa|lyria/i)
            );
    },

    buildSkillContext(skill) {
        return [
            `Skill: ${skill.name}`,
            skill.description,
            'Principles:',
            ...skill.principles.map(item => `- ${item}`),
            'Guidelines:',
            ...skill.guidelines.map(item => `- ${item}`)
        ].join('\n');
    },

    async generateCommitOptions(diff, apiKey, modelName) {
        if (!apiKey) throw new Error('API Key tidak ditemukan.');
        
        const safeDiff = diff.length > 4000 ? diff.substring(0, 4000) + '\n...[TRUNCATED]' : diff;
        const skillContext = this.buildSkillContext(SKILLS.atomicCommits);
        const prompt = `Anda adalah Senior Software Engineer. Gunakan skill berikut saat membuat pesan commit.\n\n${skillContext}\n\nBuat 3 opsi pesan Semantic Commit dalam bahasa Indonesia singkat berdasarkan git diff berikut. Setiap opsi harus mewakili satu logical change, tidak WIP, tidak terlalu umum, dan tetap reviewable. Jika diff terlalu campur aduk, pilih scope paling dominan dan buat pesan yang jujur terhadap diff. HANYA kembalikan array JSON berisi string tanpa markdown formatting. Format: ["feat: tambah tombol login", "fix: perbaiki routing"].\n\nDiff:\n${safeDiff}`;

        try {
            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
            });

            const data = await response.json();
            
            if (!response.ok) {
                const errMsg = data.error?.message || 'Server rejected request.';
                throw new Error(errMsg);
            }
            
            const textRaw = data.candidates[0].content.parts[0].text.replace(/```json|```/g, '').trim();
            return JSON.parse(textRaw);
        } catch (error) {
            throw new Error(`AI failed (${modelName}): ${error.message}`);
        }
    }
};

// --- MODUL 4: USER INTERFACE DASHBOARD (UI) ---
const UI = {
    renderSignalBar(label, value, color = THEME.primary) {
        return `${THEME.muted(label.padEnd(10, ' '))} ${color(value)}`;
    },

    renderHeader(project, branch) {
        const stats = GitOps.getStats();
        const dirtyState = Number(stats.modified) > 0 ? 'DIRTY' : 'CLEAN';
        const syncState = Number(stats.ahead) > 0 || Number(stats.behind) > 0 ? 'SYNC PENDING' : 'SYNCED';
        const content = [
            THEME.primary(ASCII_LOGO.trimEnd()),
            '',
            `${THEME.success('CONNECTED')} ${THEME.muted('GitHub workflow console')}`,
            '',
            this.renderSignalBar('PROJECT', project, THEME.text),
            this.renderSignalBar('BRANCH', branch, THEME.warning),
            this.renderSignalBar('INDEX', dirtyState, Number(stats.modified) > 0 ? THEME.accent : THEME.success),
            this.renderSignalBar('REMOTE', syncState, syncState === 'SYNCED' ? THEME.success : THEME.warning),
            this.renderSignalBar('AI SKILL', SKILLS.atomicCommits.name, THEME.accent),
            '',
            `${THEME.muted('AHEAD'.padEnd(10, ' '))} ${THEME.success(stats.ahead)}   ${THEME.muted('BEHIND')} ${THEME.error(stats.behind)}   ${THEME.muted('MODIFIED')} ${THEME.accent(stats.modified)}`
        ].join('\n');

        console.log(boxen(content, {
            padding: 1,
            margin: 1,
            borderStyle: 'round',
            borderColor: FRAME.borderColor,
            backgroundColor: '#0F172A',
            title: THEME.accent(' ghpush workspace '),
            titleAlignment: 'center'
        }));
    },

    renderBranchTable(branches) {
        const table = new Table({
            head: ['Branch', 'State', 'Last Commit'],
            chars: {
                top: '-', 'top-mid': '+', 'top-left': '+', 'top-right': '+',
                bottom: '-', 'bottom-mid': '+', 'bottom-left': '+', 'bottom-right': '+',
                left: '|', 'left-mid': '+', mid: '-', 'mid-mid': '+',
                right: '|', 'right-mid': '+', middle: '|'
            },
            style: { head: ['cyan'], border: ['grey'] }
        });
        branches.forEach(b => {
            table.push([
                b.isCurrent ? THEME.primary(b.name) : THEME.text(b.name),
                b.isCurrent ? THEME.success('active') : THEME.muted('local'),
                THEME.muted(b.lastCommit)
            ]);
        });
        console.log(table.toString());
    },

    renderNote(message, title = 'SYS') {
        note(THEME.text(message), THEME.primary(`[${title}]`));
    }
};

// --- MODUL 5: MAIN PIPELINE ROUTING ---
async function handleDeployFlow(targetProject, config, username, s) {
    // 1. Pre-Deploy Hook
    if (SysOps.hasPackageJson()) {
        const runHook = await select({
            message: THEME.accent('Package.json terdeteksi. Jalankan pre-deploy hook?'),
            options: [
                { value: 'skip', label: 'Skip / direct push' },
                { value: 'build', label: 'Run npm run build' },
                { value: 'lint', label: 'Run npm run lint' },
                { value: 'back', label: 'Return to workspace' }
            ]
        });

        if (runHook === 'back') return;

        if (runHook !== 'skip') {
            s.start(`Mengeksekusi npm run ${runHook}...`);
            try {
                SysOps.execCmd(`npm run ${runHook}`);
                s.stop(THEME.success(`Hook ${runHook} complete.`));
            } catch (err) {
                s.stop(THEME.error(`Hook ${runHook} failed. Deployment aborted.`));
                note(THEME.text(err.message), THEME.error('Error log'));
                return;
            }
        }
    }

    // 2. Interactive File Staging
    const unstagedFiles = GitOps.getUnstagedFiles();
    if (unstagedFiles.length === 0) {
        UI.renderNote('Working tree clean. No changes queued for push.', 'INF');
        return;
    }

    const stagingMode = await select({
        message: THEME.accent('Select staging mode:'),
        options: [
            { value: 'all', label: 'Stage all files' },
            { value: 'manual', label: 'Manual file selection' },
            { value: 'back', label: 'Abort and return' }
        ]
    });

    if (stagingMode === 'back') return;

    if (stagingMode === 'all') {
        GitOps.stageAllFiles();
        UI.renderNote('All modified files staged.', 'OK');
    } else {
        const selectedFiles = await multiselect({
            message: THEME.accent('Select files (space = mark, enter = commit):'),
            options: unstagedFiles.map(f => ({ value: f.file, label: `${f.status} ${f.file}` })),
            required: true
        });
        GitOps.stageFiles(selectedFiles);
    }
    
    // 3. AI Auto-Commit
    let commitMessage = '';
    const diff = GitOps.getStagedDiff();

    while (commitMessage === '') {
        const commitMethod = await select({
            message: THEME.accent('Select commit message mode:'),
            options: [
                { value: 'ai', label: `AI auto-commit (${SKILLS.atomicCommits.name})` },
                { value: 'change_model', label: 'Configure AI model' },
                { value: 'manual', label: 'Manual commit' },
                { value: 'back', label: 'Abort and return' }
            ]
        });

        if (commitMethod === 'back') return;

        let apiKey = config['GEMINI_API_KEY'];

        if (commitMethod === 'change_model' || (commitMethod === 'ai' && !apiKey)) {
            if (!apiKey) {
                apiKey = await password({ message: THEME.text('Input Gemini API key:') });
                SysOps.saveConfig('GEMINI_API_KEY', apiKey);
                config['GEMINI_API_KEY'] = apiKey;
            }

            if (commitMethod === 'change_model') {
                s.start('Fetching latest text model manifest...');
                try {
                    const availableModels = await AIOps.fetchAvailableModels(apiKey);
                    s.stop(THEME.success('Model manifest ready.'));
                    
                    const chosenModel = await select({
                        message: THEME.accent('Select active AI model:'),
                        options: [
                            ...availableModels.map(m => ({ value: m, label: m })),
                            { value: 'back', label: 'Cancel and return' }
                        ],
                        maxItems: 10
                    });
                    
                    if (chosenModel !== 'back') {
                        SysOps.saveConfig('AI_MODEL', chosenModel);
                        config['AI_MODEL'] = chosenModel;
                        UI.renderNote(`Model set to ${chosenModel}.`, 'AI');
                    }
                } catch (err) {
                    s.stop(THEME.error('Model manifest fetch failed.'));
                }
                continue;
            }
        }

        if (commitMethod === 'ai') {
            const activeModel = config['AI_MODEL'] || 'gemini-1.5-flash-latest';
            
            s.start(`Analyzing diff with ${activeModel} and ${SKILLS.atomicCommits.name}...`);
            try {
                const aiOptions = await AIOps.generateCommitOptions(diff, apiKey, activeModel);
                s.stop(THEME.success(`Analysis complete: ${activeModel}.`));
                
                const selectedOpt = await select({
                    message: THEME.accent('Select reviewable commit message:'),
                    options: [
                        ...aiOptions.map(opt => ({ value: opt, label: opt })),
                        { value: 'cancel', label: 'Cancel and reselect' }
                    ]
                });

                if (selectedOpt !== 'cancel') commitMessage = selectedOpt;
            } catch (err) {
                s.stop(THEME.error(err.message));
            }
        } else if (commitMethod === 'manual') {
            const type = await select({
                message: THEME.text('Select semantic type:'),
                options: [
                    ...['feat', 'fix', 'refactor', 'docs', 'chore'].map(t => ({ value: t, label: t })),
                    { value: 'back', label: 'Return' }
                ]
            });
            
            if (type === 'back') continue;

            const msg = await text({
                message: THEME.text('Input description:'),
                validate: val => val.length === 0 ? 'Description required.' : undefined
            });
            commitMessage = `${type}: ${msg}`;
        }
    }

    // 4. Push Eksekusi Final
    const targetBranch = GitOps.getCurrentBranch();
    s.start(`Pushing code to GitHub (branch: ${targetBranch})...`);
    try {
        GitOps.commitAndPush(commitMessage, targetBranch);
        s.stop(THEME.success('Deployment complete.'));
        UI.renderNote(`URL: https://github.com/${username}/${targetProject}/tree/${targetBranch}`, 'OK');
    } catch (err) {
        s.stop(THEME.error('Push failed.'));
        note(THEME.text(err.message), THEME.error('Error log'));
    }
}

async function handleBranchManager() {
    while (true) {
        const branches = GitOps.getAllBranches();
        const currentBranch = branches.find(b => b.isCurrent)?.name || 'main';

        UI.renderBranchTable(branches);

        const action = await select({
            message: THEME.accent(`Branch manager | active: ${THEME.text(currentBranch)}`),
            options: [
                { value: 'switch', label: 'Switch branch' },
                { value: 'create', label: 'Create local branch' },
                { value: 'delete', label: 'Delete local branch' },
                { value: 'back', label: 'Return to workspace' }
            ]
        });

        if (action === 'back') break;

        if (action === 'switch') {
            const target = await select({
                message: THEME.accent('Select target branch:'),
                options: [
                    ...branches.map(b => ({ value: b.name, label: `${b.isCurrent ? '*' : ' '} ${b.name}` })),
                    { value: 'back', label: 'Cancel' }
                ]
            });
            if (target !== 'back' && target !== currentBranch) GitOps.switchBranch(target);
        }

        if (action === 'create') {
            const newBranch = await text({
                message: THEME.text('Input new branch name:'),
                placeholder: 'example: feat/ui-update',
                validate(val) { if (val.trim().length === 0) return 'Branch name required.'; }
            });
            GitOps.createAndCheckoutBranch(newBranch);
            UI.renderNote(`Created and switched to local branch: ${newBranch}`, 'OK');
        }

        if (action === 'delete') {
            const safeToDelete = branches.filter(b => !b.isCurrent);
            if (safeToDelete.length === 0) {
                UI.renderNote('No standby branch available for deletion.', 'INF');
                continue;
            }
            const toDelete = await multiselect({
                message: THEME.error('Select local branches to delete:'),
                options: safeToDelete.map(b => ({ value: b.name, label: b.name }))
            });
            if (toDelete.length > 0) {
                GitOps.deleteBranches(toDelete);
                UI.renderNote(`Deleted branches: ${toDelete.join(', ')}`, 'OK');
            }
        }
    }
}

async function main() {
    console.clear();
    intro(THEME.primary(chalk.inverse(' SAHAL ARBANI | GHPUSH v4.7.0 MODERN TUI ')));

    const s = spinner();
    let config = SysOps.loadConfig();

    // 1. Project selection
    const projectsDir = path.join(os.homedir(), 'Projects');
    const projects = SysOps.getProjects(projectsDir);
    
    if (projects.length === 0) {
        outro(THEME.error(`No project directory found at ${projectsDir}`));
        return;
    }

    const targetProject = await select({
        message: THEME.accent('Select project workspace:'),
        options: projects.map(p => ({ value: p, label: p })),
        maxItems: 8
    });

    const projectPath = path.join(projectsDir, targetProject);
    GitOps.initRepo(projectPath);

    // 2. Cek Remote
    const { username, exists } = GitOps.checkRemote(targetProject);
    if (!exists) {
        const isPrivate = await confirm({
            message: THEME.text('Remote repository missing. Create as private?'),
            initialValue: true
        });
        s.start('Building remote repository...');
        GitOps.createRemote(targetProject, isPrivate);
        s.stop(THEME.success('Remote repository online.'));
    }

    // 3. Control deck loop
    while (true) {
        const currentBranch = GitOps.getCurrentBranch();
        
        // Render Control Deck dashboard.
        UI.renderHeader(targetProject, currentBranch);

        const action = await select({
            message: THEME.accent(`Workspace actions :: ${targetProject}`),
            options: [
                { value: 'deploy', label: 'Deploy code (commit & push)' },
                { value: 'branch', label: 'Branch manager' },
                { value: 'exit', label: 'Exit workspace' }
            ]
        });

        if (action === 'exit') {
            outro(THEME.primary('Session terminated.'));
            break;
        }

        if (action === 'branch') {
            await handleBranchManager();
        }

        if (action === 'deploy') {
            await handleDeployFlow(targetProject, config, username, s);
        }
    }
}

main().catch(console.error);
